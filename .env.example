# KIS 공식 Open API (apiportal.koreainvestment.com에서 발급)
KIS_MODE=paper
KIS_ACCOUNT=00000000-01
KIS_APPKEY=
KIS_SECRET=
# 모의투자 전용 키 (paper 모드에서 우선 사용, 없으면 위 실전 키 사용)
KIS_VIRTUAL_APPKEY=
KIS_VIRTUAL_SECRET=
# HTS ID — 웹소켓 체결통보 도입 시에만 필요 (REST는 불필요)
KIS_ID=
KIS_VIRTUAL_ID=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# DART 공시 (opendart.fss.or.kr 발급, 대시보드 공시 패널용 — 없어도 봇 동작)
DART_API_KEY=
# 네이버 뉴스 검색 — 신규 발급은 네이버클라우드 NAVER API HUB (www.ncloud.com)
# 콘솔 > NAVER API HUB > Application 등록 > 검색(뉴스) 선택 -> 키 2개
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=
# (구형 개발자센터 키 보유 시 — 2027-06-30까지 유효)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
